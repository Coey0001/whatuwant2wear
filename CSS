
:root {
  --bg: #f7f4ef;
  --paper: #fffdf9;
  --cream: #eee5d9;
  --beige: #d6c3ae;
  --brown: #8c7764;
  --ink: #35332f;
  --muted: #8d8982;
  --line: #e5dfd6;
  --sage: #a7aa97;
  --radius: 18px;
  --shadow: 0 8px 28px rgba(65, 53, 41, 0.06);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "Noto Sans TC", "Noto Sans", Arial, sans-serif;
  font-size: 14px;
  line-height: 1.8;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
select:focus-visible {
  outline: 2px solid var(--brown);
  outline-offset: 4px;
}

.navbar {
  min-height: 76px;
  padding: 0 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
  background: rgba(247, 244, 239, 0.94);
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(12px);
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

.logo-mark {
  width: 33px;
  height: 33px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--paper);
  font-family: Georgia, serif;
  font-size: 18px;
  letter-spacing: -1px;
}

.navbar nav {
  display: flex;
  gap: 30px;
  align-items: center;
}

.navbar nav a {
  color: #6f6a63;
  font-size: 12px;
  transition: color 0.2s;
}

.navbar nav a:hover,
.text-link:hover {
  color: var(--brown);
}

#saved-count {
  display: inline-grid;
  place-items: center;
  min-width: 19px;
  height: 19px;
  padding: 0 4px;
  margin-left: 3px;
  background: var(--cream);
  border-radius: 20px;
  font-size: 10px;
}

.hero {
  max-width: 1200px;
  min-height: 510px;
  margin: auto;
  padding: 65px 7% 75px;
  display: grid;
  grid-template-columns: 1fr 0.85fr;
  align-items: center;
  gap: 55px;
}

.eyebrow {
  margin: 0 0 14px;
  color: var(--brown);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.3px;
}

.hero h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(40px, 5vw, 65px);
  font-weight: 500;
  line-height: 1.18;
  letter-spacing: -2px;
}

.hero h1 span {
  color: var(--brown);
  font-style: italic;
}

.hero-desc {
  margin: 25px 0;
  color: #77716a;
  font-size: 13px;
  line-height: 2.2;
}

.text-link {
  display: inline-block;
  padding-bottom: 5px;
  border-bottom: 1px solid var(--brown);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  transition: color 0.2s;
}

.hero-visual {
  position: relative;
  padding: 0 15px 20px 0;
}

.hero-photo {
  position: relative;
  height: 370px;
  overflow: hidden;
  background: var(--cream);
  border-radius: 180px 180px 8px 8px;
}

.hero-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s;
}

.hero-photo:hover img {
  transform: scale(1.03);
}

.photo-fallback {
  background:
    linear-gradient(145deg, transparent 45%, #d4c4b2 45% 65%, transparent 65%),
    linear-gradient(35deg, #eee4d7, #c6b6a4);
}

.photo-label {
  position: absolute;
  bottom: 16px;
  left: 16px;
  color: white;
  font-size: 9px;
  letter-spacing: 2px;
  text-shadow: 0 1px 5px #555;
}

.hero-note {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 15px 20px;
  background: var(--paper);
  box-shadow: var(--shadow);
  font-family: Georgia, serif;
  font-size: 12px;
  font-style: italic;
  line-height: 1.8;
}

.section {
  max-width: 1050px;
  margin: 0 auto;
  padding: 76px 6%;
}

.discover,
.saved-section {
  background: var(--paper);
  max-width: none;
  padding-left: max(6%, calc((100% - 900px) / 2));
  padding-right: max(6%, calc((100% - 900px) / 2));
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 32px;
}

.section-heading h2 {
  margin: 0;
  font-size: 27px;
  font-weight: 600;
  letter-spacing: -0.8px;
}

.muted {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.step-label {
  flex-shrink: 0;
  color: #a39b91;
  font-size: 10px;
  letter-spacing: 1.5px;
}

.filter-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px 24px;
  padding: 32px;
  background: #faf8f4;
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.field label {
  font-size: 12px;
  font-weight: 600;
}

.field select {
  width: 100%;
  min-height: 48px;
  padding: 0 13px;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid #e4ddd3;
  border-radius: 9px;
  outline-color: var(--brown);
}

.primary-btn,
.secondary-btn {
  min-height: 46px;
  padding: 11px 18px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  transition: background 0.2s, transform 0.2s;
}

.primary-btn {
  color: white;
  background: var(--ink);
  border: 1px solid var(--ink);
}

.primary-btn:hover {
  background: #62574b;
  transform: translateY(-1px);
}

.primary-btn span {
  margin-left: 14px;
}

.secondary-btn {
  color: var(--ink);
  background: transparent;
  border: 1px solid #d9d0c4;
}

.secondary-btn:hover {
  background: var(--cream);
}

.filter-panel > .primary-btn {
  align-self: end;
}

.form-hint {
  align-self: center;
  margin: 0;
  color: #aaa197;
  font-size: 9px;
  letter-spacing: 1.8px;
  text-align: center;
}

.result-section {
  padding-top: 85px;
  padding-bottom: 85px;
}

.empty-state {
  padding: 60px 20px;
  text-align: center;
  border: 1px dashed #d9d0c4;
  border-radius: var(--radius);
  background: rgba(255, 253, 249, 0.5);
}

.empty-icon {
  color: var(--brown);
  font-size: 32px;
}

.empty-state h3 {
  margin: 12px 0 5px;
  font-size: 17px;
  font-weight: 600;
}

.empty-state p {
  color: var(--muted);
  font-size: 12px;
}

.outfit-result[hidden],
.empty-state[hidden] {
  display: none !important;
}

.outfit-main {
  display: grid;
  grid-template-columns: 0.95fr 1fr;
  gap: 42px;
  align-items: center;
}

.outfit-cover {
  position: relative;
  height: 430px;
  overflow: hidden;
  background: var(--cream);
  border-radius: var(--radius);
}

.outfit-cover img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.look-number {
  position: absolute;
  bottom: 15px;
  left: 15px;
  padding: 6px 12px;
  color: var(--ink);
  background: rgba(255, 253, 249, 0.92);
  border-radius: 20px;
  font-size: 10px;
  letter-spacing: 1px;
}

.outfit-info h3 {
  margin: 0 0 12px;
  font-family: Georgia, serif;
  font-size: 29px;
  font-weight: 500;
  line-height: 1.3;
}

.outfit-reason {
  color: #77716a;
  font-size: 12px;
  line-height: 2;
}

.color-row {
  margin: 26px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.color-row > span {
  font-size: 9px;
  letter-spacing: 1.2px;
}

.color-palette {
  display: flex;
  gap: 8px;
}

.swatch {
  width: 23px;
  height: 23px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 50%;
}

.match-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
}

.match-row strong {
  font-size: 13px;
}

.match-track {
  height: 4px;
  margin-top: 10px;
  overflow: hidden;
  background: #e9e3da;
  border-radius: 5px;
}

.match-bar {
  height: 100%;
  width: 0;
  background: var(--brown);
  transition: width 0.5s;
}

.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}

.result-actions .primary-btn {
  flex: 1;
}

.pieces-heading {
  margin: 55px 0 20px;
}

.pieces-heading h3 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: 23px;
  font-weight: 500;
}

.pieces-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.piece-card {
  padding: 20px 16px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 12px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.piece-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.piece-category {
  color: var(--brown);
  font-size: 9px;
  letter-spacing: 1.5px;
}

.piece-card h4 {
  margin: 8px 0 4px;
  font-size: 13px;
  font-weight: 600;
}

.piece-card p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.piece-card button {
  margin-top: 14px;
  padding: 5px 0;
  color: var(--brown);
  background: transparent;
  border: none;
  border-bottom: 1px solid #d9cbb9;
  font-size: 10px;
}

.outfit-tip {
  margin-top: 24px;
  padding: 18px 20px;
  background: #f2ede5;
  border-radius: 10px;
  color: #71675d;
  font-size: 12px;
}

.saved-section {
  background: #f1ece4;
}

.saved-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.saved-empty {
  grid-column: 1 / -1;
  padding: 35px 20px;
  color: var(--muted);
  background: rgba(255, 253, 249, 0.65);
  border: 1px dashed #d7ccbe;
  border-radius: 12px;
  text-align: center;
  font-size: 12px;
}

.saved-card {
  min-width: 0;
  overflow: hidden;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 12px;
}

.saved-card img {
  display: block;
  width: 100%;
  height: 190px;
  object-fit: cover;
  background: var(--cream);
}

.saved-card-body {
  padding: 15px;
}

.saved-card h3 {
  margin: 0;
  font-size: 14px;
}

.saved-card p {
  color: var(--muted);
  font-size: 11px;
}

.saved-card button {
  margin-top: 5px;
  padding: 6px 0;
  color: var(--brown);
  background: transparent;
  border: none;
  font-size: 11px;
}

.footer {
  min-height: 115px;
  padding: 30px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  background: var(--bg);
}

.footer p,
.footer > span {
  color: var(--muted);
  font-size: 10px;
}

@media (max-width: 700px) {
  .navbar {
    padding: 13px 5%;
    min-height: 65px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .navbar nav {
    gap: 16px;
  }

  .navbar nav a {
    font-size: 10px;
  }

  .hero {
    min-height: auto;
    padding: 50px 6%;
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .hero h1 {
    font-size: 48px;
  }

  .hero-visual {
    max-width: 430px;
    width: 100%;
    margin: 0 auto;
  }

  .hero-photo {
    height: 340px;
  }

  .section,
  .discover,
  .saved-section {
    padding: 55px 6%;
  }

  .section-heading {
    align-items: flex-start;
  }

  .section-heading h2 {
    font-size: 23px;
  }

  .step-label {
    padding-top: 4px;
    font-size: 8px;
  }

  .filter-panel {
    padding: 22px 17px;
    gap: 21px 12px;
  }

  .field select {
    font-size: 11px;
    padding: 0 8px;
  }

  .form-hint {
    font-size: 8px;
  }

  .outfit-main {
    grid-template-columns: 1fr;
    gap: 27px;
  }

  .outfit-cover {
    height: 380px;
  }

  .outfit-info h3 {
    font-size: 26px;
  }

  .pieces-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .saved-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .saved-card img {
    height: 150px;
  }

  .footer {
    padding: 25px 6%;
  }
}

@media (max-width: 400px) {
  .navbar nav {
    gap: 10px;
  }

  .navbar .logo {
    font-size: 10px;
    letter-spacing: 1px;
  }

  .filter-panel {
    grid-template-columns: 1fr;
  }

  .form-hint {
    display: none;
  }

  .pieces-grid,
  .saved-list {
    grid-template-columns: 1fr;
  }

  .piece-card {
    padding: 18px;
  }

  .saved-card img {
    height: 220px;
  }

  .outfit-cover {
    height: 330px;
  }

  .result-actions {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
