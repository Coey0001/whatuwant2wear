const form = document.getElementById("style-form");
const emptyState = document.getElementById("empty-state");
const resultBox = document.getElementById("outfit-result");
const savedList = document.getElementById("saved-list");
const savedCount = document.getElementById("saved-count");

let currentOutfit = null;
let lastOutfitId = null;
let currentScore = 0;
let currentColors = [];
let currentPieces = {};
let currentImage = "";
let savedOutfits = loadSaved();
let recommendationNumber = 0;

const labels = {
  top: "上衣",
  bottom: "下身",
  shoes: "鞋子",
  bag: "包包",
  accessory: "配飾",
  hair: "髮型"
};

