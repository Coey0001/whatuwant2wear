  "奶油白": "#F0E7D8",
  "大地色": "#B49A7B",
  "灰黑": "#555451",
  "牛仔藍": "#718BA6",
  "粉色": "#E8C7CA"
};

function loadSaved() {
  try {
    const data = JSON.parse(localStorage.getItem("styleAheadSaved") || "[]");
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
}

function persistSaved() {
  try {
    localStorage.setItem("styleAheadSaved", JSON.stringify(savedOutfits));
  } catch {
    alert("目前無法儲存收藏，請檢查瀏覽器的儲存設定。");
  }
}

function getConditions() {
  return {
    occasion: document.getElementById("occasion").value,
    style: document.getElementById("style").value,
    weather: document.getElementById("weather").value,
    temperature: document.getElementById("temperature").value,
    color: document.getElementById("color").value,
    preference: document.getElementById("preference").value
  };
}

function getScore(outfit, c) {
  let score = 0;

  score += outfit.occasions.includes(c.occasion) ? 30 : 0;
  score += outfit.styles.includes(c.style) ? 30 : 0;
  score += outfit.colors.includes(c.color) ? 15 : 0;
  score += outfit.temps.includes(c.temperature) ? 15 : 0;
  score += outfit.weather.includes(c.weather) ? 10 : 0;

  if (c.preference === "顯高" && outfit.id === "look02") score += 4;
  if (c.preference === "舒適" && outfit.id === "look04") score += 4;
  if (c.preference === "層次" && outfit.id === "look05") score += 4;
  if (c.preference === "簡約" && outfit.id === "look02") score += 3;

  // 寒冷天氣不推薦缺乏保暖層次的組合
  if (c.temperature === "cool" && !outfit.temps.includes("cool")) {
    score -= 25;
  }

  if (c.weather === "雨天" && outfit.id !== "look05" && outfit.id !== "look04") {
    score -= 8;
  }

  return Math.max(0, Math.min(100, score));
}

function chooseOutfit() {
  const conditions = getConditions();

  const ranked = outfits
    .map(outfit => ({
      outfit,
      score: getScore(outfit, conditions)
    }))
    .sort((a, b) => b.score - a.score);

  const bestScore = ranked[0].score;
  const closeMatches = ranked.filter(item => item.score >= bestScore - 15);

  // 優先選擇分數接近、但不是上一套的搭配
  let choices = closeMatches.filter(item =>
    item.outfit.id !== lastOutfitId
  );

  if (!choices.length) choices = closeMatches;

  const chosen = choices[Math.floor(Math.random() * choices.length)];

  recommendationNumber++;
  currentOutfit = chosen.outfit;
  lastOutfitId = chosen.outfit.id;
  currentScore = chosen.score;
  currentColors = [...chosen.outfit.palette];
  currentPieces = JSON.parse(JSON.stringify(chosen.outfit.pieces));
  currentImage = chosen.outfit.image;

  renderOutfit();
}

function renderOutfit() {
  if (!currentOutfit) return;

  emptyState.hidden = true;
  resultBox.hidden = false;

  document.getElementById("outfit-image").src = currentImage;
  document.getElementById("outfit-image").alt = currentOutfit.title + " 穿搭參考";
  document.getElementById("outfit-style").textContent =
    currentOutfit.style.toUpperCase();
  document.getElementById("outfit-title").textContent = currentOutfit.title;
  document.getElementById("outfit-reason").textContent = currentOutfit.reason;
  document.getElementById("look-number").textContent =
    "LOOK " + String(recommendationNumber).padStart(2, "0");

  document.getElementById("match-score").textContent = currentScore + "%";
  document.getElementById("match-bar").style.width = currentScore + "%";

  const palette = document.getElementById("color-palette");
  palette.replaceChildren();

  currentColors.forEach(color => {
    const swatch = document.createElement("span");
    swatch.className = "swatch";
    swatch.style.backgroundColor = color;
    swatch.title = color;
    swatch.setAttribute("aria-label", "配色 " + color);
    palette.appendChild(swatch);
  });

  document.getElementById("outfit-tip").textContent =
    "STYLE NOTE — " + currentOutfit.tip;

  renderPieces();
  updateSaveButton();

  // 只在使用者按下生成或重新推薦時捲動到結果
}

function renderPieces() {
  const grid = document.getElementById("pieces-grid");
  grid.replaceChildren();

  Object.entries(currentPieces).forEach(([key, piece]) => {
    const card = document.createElement("article");
    card.className = "piece-card";

    const category = document.createElement("span");
    category.className = "piece-category";
    category.textContent = piece.category;

    const title = document.createElement("h4");
    title.textContent = piece.name;

    const desc = document.createElement("p");
    desc.textContent = piece.desc;

    const button = document.createElement("button");
    button.type = "button";
    button.textContent = "↻ 更換" + labels[key];
    button.addEventListener("click", () => replacePiece(key));

    card.append(category, title, desc, button);
    grid.appendChild(card);
  });
}

function replacePiece(key) {
  const piece = currentPieces[key];
  const alternatives = piece.options.filter(name => name !== piece.name);

  if (!alternatives.length) return;

  const nextIndex = Math.floor(Math.random() * alternatives.length);
  currentPieces[key] = {
    ...piece,
    name: alternatives[nextIndex],
    options: piece.options
  };

  renderPieces();
  updateSaveButton();
}

function updateSaveButton() {
  const button = document.getElementById("save-btn");
  const exists = currentOutfit && savedOutfits.some(item =>
    item.key === getCurrentKey()
  );

  button.textContent = exists ? "♥ 已收藏" : "♡ 收藏穿搭";
}

function getCurrentKey() {
  return currentOutfit.id + "|" +
    Object.entries(currentPieces)
      .map(([key, piece]) => key + ":" + piece.name)
      .join("|");
}

function saveCurrentOutfit() {
  if (!currentOutfit) return;

  const key = getCurrentKey();
  const index = savedOutfits.findIndex(item => item.key === key);

  if (index >= 0) {
    savedOutfits.splice(index, 1);
  } else {
    savedOutfits.unshift({
      key,
      id: currentOutfit.id,
      title: currentOutfit.title,
      style: currentOutfit.style,
      image: currentImage,
      pieces: JSON.parse(JSON.stringify(currentPieces)),
      colors: [...currentColors],
      savedAt: new Date().toISOString()
    });
  }

  persistSaved();
  renderSaved();
  updateSaveButton();
}

function renderSaved() {
  savedCount.textContent = savedOutfits.length;
  savedList.replaceChildren();

  if (!savedOutfits.length) {
    const message = document.createElement("p");
    message.className = "saved-empty";
    message.textContent =
      "還沒有收藏的穿搭，遇到喜歡的搭配就把它留下來吧 ♡";
    savedList.appendChild(message);
    return;
  }

  savedOutfits.forEach(item => {
    const card = document.createElement("article");
    card.className = "saved-card";

    const img = document.createElement("img");
    img.src = item.image;
    img.alt = item.title + " 穿搭";
    img.loading = "lazy";
    img.onerror = () => {
      img.style.display = "none";
    };

    const body = document.createElement("div");
    body.className = "saved-card-body";

    const title = document.createElement("h3");
    title.textContent = item.title;

    const style = document.createElement("p");
    style.textContent = item.style;

    const detail = document.createElement("p");
    detail.textContent = Object.entries(item.pieces)
      .map(([key, piece]) => labels[key] + "：" + piece.name)
      .join(" · ");

    const remove = document.createElement("button");
    remove.type = "button";
    remove.textContent = "♡ 取消收藏";
    remove.addEventListener("click", () => {
      savedOutfits = savedOutfits.filter(saved => saved.key !== item.key);
      persistSaved();
      renderSaved();
      updateSaveButton();
    });

    body.append(title, style, detail, remove);
    card.append(img, body);
    savedList.appendChild(card);
  });
}

form.addEventListener("submit", event => {
  event.preventDefault();
  chooseOutfit();
  document.getElementById("result").scrollIntoView({
    behavior: "smooth",
    block: "start"
  });
});

document.getElementById("refresh-btn").addEventListener("click", () => {
  chooseOutfit();
});

document.getElementById("save-btn").addEventListener("click", () => {
  saveCurrentOutfit();
});

renderSaved();
